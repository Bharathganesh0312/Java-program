class Constructor {
    String name;
    int age;

    Student(String name, int age) {
        this.name = name;
        this.age = age;
    }

    void display() {
        System.out.println(name + " " + age);
    }
}

public class Main {
    public static void main(String[] args) {

        Student s1 = new Student("Nagaraj", 21);
        Student s2 = new Student("Arun", 22);

        s1.display();
        s2.display();
    }
}
